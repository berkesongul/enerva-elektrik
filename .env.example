# === Enerva Elektrik — Environment Variables ===

# PostgreSQL connection string (create a separate database for local development)
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/enerva_elektrik_dev?schema=public"

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-key-here"

NEXTAUTH_URL="http://localhost:3000"

# Local seed only: choose a strong password before running npm run db:seed
ADMIN_SEED_PASSWORD="replace-with-a-strong-local-password"
