# Alan adını sadece host adı olarak yazın: enervaelektrik.com
DOMAIN=enervaelektrik.com

# Güçlü ve URL açısından güvenli değerler kullanın.
POSTGRES_DB=enerva_elektrik
POSTGRES_USER=enerva
POSTGRES_PASSWORD=change-this-database-password
AUTH_SECRET=change-this-auth-secret

# İlk admin hesabı için kullanılır.
ADMIN_EMAIL=admin@enervaelektrik.com
ADMIN_PASSWORD=change-this-admin-password
